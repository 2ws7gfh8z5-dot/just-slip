{
  "name": "just-slip",
  "version": "3.0.0",
  "description": "Control screen brightness/volume with customizable trackpad gestures - Cross-platform with Three.js 3D UI",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"tsc -w -p tsconfig.main.json\" \"tsc -w -p tsconfig.renderer.json\" \"electron .\"",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "start": "electron .",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux",
    "package:all": "electron-builder --mac --win --linux"
  },
  "keywords": [
    "brightness",
    "volume",
    "trackpad",
    "gesture",
    "electron",
    "threejs",
    "cross-platform",
    "macos",
    "windows",
    "linux"
  ],
  "author": "Huaziyi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2ws7gfh8z5-dot/just-slip"
  },
  "bugs": {
    "url": "https://github.com/2ws7gfh8z5-dot/just-slip/issues"
  },
  "homepage": "https://github.com/2ws7gfh8z5-dot/just-slip#readme",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.160.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "build": {
    "appId": "com.justslip.app",
    "productName": "Just Slip",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/brightness.py",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "artifactName": "Just-Slip-${version}-mac-${arch}.dmg",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Just-Slip-${version}-windows-x64.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Just-Slip-${version}-linux-x64.AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
