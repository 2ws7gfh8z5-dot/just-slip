{
  "compilerOptions": {
    "outDir": "./dist/main",
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": false
  },
  "include": ["src/main/**/*"],
  "exclude": ["node_modules", "dist"]
}
