{
  "compilerOptions": {
    "outDir": "./dist/renderer",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "target": "ES2020",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "types": ["three"]
  },
  "include": ["src/renderer/**/*"],
  "exclude": ["node_modules", "dist"]
}
